{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AIweather-Anurag/ottasia",
  "title": "OTTASIA: Where to Watch Asia",
  "description": "Where to watch X in Y? 30 Asian and Middle Eastern streaming markets, for any AI assistant.",
  "websiteUrl": "https://ottasia.com",
  "icons": [
    {
      "src": "https://ottasia.com/icon2",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://ottasia.com/icon1",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/AIweather-Anurag/ottasia-mcp-server",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ottasia/mcp-server",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://ottasia.com/api/mcp/sse"
    }
  ]
}
